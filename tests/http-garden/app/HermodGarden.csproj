<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Hermod.HTTP1.Garden</RootNamespace>
    <AssemblyName>HermodGarden</AssemblyName>

    <!-- Built twice from two places: from this checkout, against the Hermod
         submodule next door, and inside the http-garden image, against a
         clone the Dockerfile pins. The image passes -p:HermodPath=… . -->
    <HermodPath Condition="'$(HermodPath)' == ''">$(MSBuildThisFileDirectory)../../../libs/Hermod/Hermod/Hermod.csproj</HermodPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(HermodPath)" />
  </ItemGroup>

</Project>
