<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Hermod.HTTP1.Tests</RootNamespace>
    <AssemblyName>h1fuzz</AssemblyName>

    <!-- A fuzzer built in Debug spends its budget in the debugger instead of
         in the parser. Release is the default; the harness says so if it finds
         itself in Debug anyway. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <!-- Beside the binary, so `dotnet run` and a published build read the
         same list. -->
    <None Include="known-findings.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\Hermod\Hermod\Hermod.csproj" />
    <ProjectReference Include="..\..\libs\Styx\Styx\Styx.csproj" />
  </ItemGroup>

</Project>
