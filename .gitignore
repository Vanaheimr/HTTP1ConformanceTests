# .NET build output
bin/
obj/
out/

# Rider / VS / VS Code
.idea/
.vs/
.vscode/
*.user
*.suo

# Certificates accidentally exported
*.pfx
*.p12

# OS
.DS_Store
Thumbs.db

# Git Bash rewrites "/dev/null" to "nul" when it reaches a Windows binary, and
# under some invocations that lands as a real file in the working directory
# instead of the null device. git cannot even index it ("short read while
# indexing nul"), so an accidental one breaks `git add -A` outright.
nul

# Autobahn TestSuite output (generated by tests/autobahn.{ps1,sh})
tests/autobahn/reports/

# Third-party suites checked out on demand (http-garden, smuggler, …)
tests/thirdparty/

# Playwright / Node
node_modules/
tools/browser/test-results/

# Auto-generated launch profiles (machine-specific ports)
tests/*/Properties/launchSettings.json
Demo/Properties/launchSettings.json
